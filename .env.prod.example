# ============================================================
# GradPath 服务器生产环境模板 — 复制为同目录 .env 并逐项填写
# （docker-compose.prod.yml 自动读取本文件中的 ${VAR} 占位符）
#
# 所有密码生成命令：
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ============================================================

# ── 数据库（compose 内部服务 db 使用）──
POSTGRES_DB=gradpath
POSTGRES_USER=gradpath
POSTGRES_PASSWORD=<generate>

# ── Redis（缓存/Celery broker，必须强密码）──
REDIS_PASSWORD=<generate>

# ── 应用安全 ──
SECRET_KEY=<generate-64-char>
ENVIRONMENT=production
LOG_LEVEL=INFO

# ── CORS：填你的正式域名 + 过渡期 IP ──
# 例：https://gradpath.cn,http://123.45.67.89
CORS_ORIGINS=<your-domain(s)>

# ── LLM（留空则 AgentChat 等 AI 功能关闭，其余功能正常）──
LLM_API_KEY=
LLM_MODEL=glm-4
LLM_DAILY_QUOTA=100

# ── Flower（Celery 监控面板 http://127.0.0.1:5555/flower）──
FLOWER_USER=admin
FLOWER_PASSWORD=<generate>

# ── RSSHub 地址（compose 内固定值，勿改）──
RSSHUB_BASE_URL=http://rsshub:1200

# ── Server酱微信推送（运维告警/新反馈通知/备份失败告警）──
# 从 https://sct.ftqq.com 获取，形如 https://sctapi.ftqq.com/XXXX.send；留空=不发
# 服务器上可直接引用：SERVERCHAN_WEBHOOK_URL=$(cat ~/.sec_webhook_url)
SERVERCHAN_WEBHOOK_URL=

# ── 可选：数据更新 webhook（n8n），不需要就留空 ──
# DATA_UPDATE_WEBHOOK_URL=
